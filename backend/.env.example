# Meta Developers > App settings > Basic > App Secret
META_APP_SECRET=

# Token propio para verificar el callback del webhook en Meta
META_VERIFY_TOKEN=

# Token de acceso de la Página conectada a Messenger
META_PAGE_ACCESS_TOKEN=

# Opcional: token de acceso de Instagram si se usa Instagram API with Instagram Login.
# Si Instagram está conectado a una Página y se usa Messenger API, puede usar el token de Página.
META_INSTAGRAM_ACCESS_TOKEN=

# Graph API version habilitada para la aplicación Meta
META_GRAPH_VERSION=v25.0

# Opcional: cambia a https://graph.instagram.com/v25.0 si usas Instagram API with Instagram Login
META_INSTAGRAM_API_BASE=
